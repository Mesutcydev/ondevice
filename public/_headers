/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY

# Screenshots are re-captured per release but keep stable filenames, so cache
# for a day and serve stale while revalidating instead of caching forever.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# site.css and site.js are referenced with a ?v= query string that is bumped on
# every change; the bare paths must always revalidate so a deploy lands at once.
/assets/site.css
  Cache-Control: no-cache

/assets/site.js
  Cache-Control: no-cache
