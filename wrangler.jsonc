{
  // The Worker canonicalizes the URL before serving the existing static assets.
  "name": "ondevice",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Custom domains: Cloudflare creates the DNS records and issues the
  // certificates automatically. Requires DNS Edit permission on the zone.
  "routes": [
    { "pattern": "ondevice.fun", "custom_domain": true },
    { "pattern": "www.ondevice.fun", "custom_domain": true }
  ]
}
